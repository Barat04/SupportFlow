# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/supportflow

# Security & CORS
# Note: For production, specify your exact frontend domain
CLIENT_URL=http://localhost:5173

# JWT Configuration (for upcoming Auth stage)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
